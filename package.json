{
  "name": "test-hook",
  "version": "1.0.0",
  "description": "Test receiver for center-hook: stores every received LINE webhook event for inspection",
  "module": "index.ts",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun index.ts",
    "dev": "bun --watch index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "bunx --bun prisma generate",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:deploy": "bunx --bun prisma migrate deploy",
    "db:studio": "bunx --bun prisma studio",
    "docker:db": "docker compose up -d postgres"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@line/bot-sdk": "^11.4.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "hono": "^4.13.18",
    "pino": "^10.4.0",
    "prisma": "7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "prisma",
    "@prisma/engines",
    "@prisma/client"
  ]
}
